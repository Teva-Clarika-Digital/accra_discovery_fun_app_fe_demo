# ---------------------------------------------------------------------------
# Esther's Hangout App — environment
#
# The app runs with ZERO configuration. Every variable below is optional and has
# a sensible keyless default. Copy to `.env.local` to override.
# ---------------------------------------------------------------------------

# Canonical origin, used for canonical links, Open Graph URLs, sitemap and robots.
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Map
# ---------------------------------------------------------------------------

# A MapLibre style JSON URL for the basemap.
# Default (keyless, free, light/"paper" look): https://tiles.openfreemap.org/styles/positron
# Point this at MapTiler / Protomaps / your own tiles for a custom look.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional public raster tile template, used as a fallback when the style above
# fails to load. Defaults to OpenStreetMap standard tiles.
NEXT_PUBLIC_MAP_TILE_URL=

# Where to open a tapped marker. One of: locate | accra
NEXT_PUBLIC_MAP_HOME=accra

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------

# Set to "1" in CI to make warnings fatal.
NEXT_PUBLIC_CI=
